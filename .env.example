# Kontaktformular – SMTP-Zugang des bestehenden Mailanbieters (z. B. Brevo, Mailjet,
# eigener Mailserver). Ohne diese Werte nimmt das Formular keine Anfragen an, sondern
# verweist die Besucher auf Telefon und WhatsApp – so geht keine Anfrage still verloren.
#
# Diese Datei ist die Vorlage. Für die lokale Entwicklung als .env.local kopieren,
# im Deployment (Coolify) als Environment Variables hinterlegen.

SMTP_HOST="smtp-relay.beispiel.de"
SMTP_PORT="587"
SMTP_USER="benutzername"
SMTP_PASSWORD="passwort"

# Absender, der beim Empfänger im Von-Feld steht. Muss beim Anbieter freigegeben sein.
SMTP_FROM="Website <website@eventservice-calabrese.de>"

# Postfach, in dem die Anfragen ankommen sollen.
KONTAKT_EMPFAENGER="info@eventservice-calabrese.de"
