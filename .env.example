# Kontaktformular – Versand über Resend (resend.com). Ohne diese Werte nimmt das
# Formular keine Anfragen an, sondern verweist die Besucher auf Telefon und
# WhatsApp – so geht keine Anfrage still verloren.
#
# Diese Datei ist die Vorlage. Für die lokale Entwicklung als .env.local kopieren,
# im Deployment (Coolify) als Environment Variables hinterlegen.

# API-Key aus dashboard.resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Absender, der beim Empfänger im Von-Feld steht. Die Domain muss bei Resend
# verifiziert sein (dashboard.resend.com/domains), sonst weist die API den
# Versand ab.
RESEND_FROM="Website <website@eventservice-calabrese.de>"

# Postfach, in dem die Anfragen ankommen sollen.
KONTAKT_EMPFAENGER="info@eventservice-calabrese.de"
